    <style>
        :root {
            --shopee-orange: #EE4D2D;
            --pink-primary: #FF2A7A;
            --pink-light: #FFF0F5;
            --yellow-accent: #FFC107;
            --purple-accent: #9C27B0;
            --text-dark: #222222;
            --text-light: #555555;
            --white: #FFFFFF;
            --gradient-main: linear-gradient(135deg, #FF2A7A 0%, #EE4D2D 100%);
            --gradient-button: linear-gradient(135deg, #0088CC 0%, #00A8E8 100%);
            --gradient-button-shopee: linear-gradient(135deg, #EE4D2D 0%, #FF2A7A 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #FFF8F9;
            color: var(--text-dark);
            overflow-x: hidden;
            padding-bottom: 80px; /* Espaço para barra fixa mobile */
        }

        /* Animações Flutuantes e Brilhos */
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 4px 15px rgba(238, 77, 45, 0.4); }
            50% { transform: scale(1.04); box-shadow: 0 8px 25px rgba(255, 42, 122, 0.6); }
            100% { transform: scale(1); box-shadow: 0 4px 15px rgba(238, 77, 45, 0.4); }
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(3deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        .container {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            padding: 0 16px;
        }

        /* Top Bar Urgência */
        .top-banner {
            background: #FFE5EC;
            color: var(--pink-primary);
            text-align: center;
            padding: 8px 12px;
            font-size: 0.85rem;
            font-weight: 700;
            border-bottom: 2px dashed #FFB6C1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* Header / Hero Section */
        .hero {
            background: white;
            border-radius: 0 0 30px 30px;
            padding: 24px 16px 30px 16px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(255, 42, 122, 0.08);
            position: relative;
            background-image: radial-gradient(#ffe0e9 10%, transparent 11%);
            background-size: 20px 20px;
        }

        .profile-badge {
            width: 95px;
            height: 95px;
            border-radius: 50%;
            background: var(--gradient-main);
            margin: 0 auto 12px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.8rem;
            box-shadow: 0 6px 20px rgba(238, 77, 45, 0.3);
            border: 4px solid white;
            animation: float 4s ease-in-out infinite;
        }

        .brand-name {
            font-family: 'Fredoka', cursive;
            font-size: 1.6rem;
            color: var(--shopee-orange);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .hero h1 {
            font-size: 1.35rem;
            line-height: 1.3;
            color: #111;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .hero h1 span {
            color: var(--pink-primary);
            background: linear-gradient(120deg, #FFE5EC 0%, #FFE5EC 100%);
            padding: 0 4px;
            border-radius: 4px;
        }

        .subtitle {
            font-size: 0.92rem;
            color: var(--text-light);
            line-height: 1.4;
            margin-bottom: 16px;
        }

        /* Botão CTA Principal */
        .btn-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: var(--gradient-main);
            color: white;
            text-decoration: none;
            font-size: 1.15rem;
            font-weight: 800;
            padding: 16px 20px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
